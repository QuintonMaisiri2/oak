# ==========================================
# EMAIL DELIVERY CONFIGURATION
# Default: EMAIL_PROVIDER=smtp (Google Workspace / Gmail SMTP)
# Alternative: EMAIL_PROVIDER=resend
# Test deliverability live at /admin/email-test
# ==========================================
EMAIL_PROVIDER=smtp

# --- OPTION 1: GOOGLE WORKSPACE / GMAIL SMTP (Recommended) ---
# 1. Use an active individual Google Workspace mailbox (e.g. bookings@uncommon.org).
#    NOTE: Aliases, Google Groups, and shared mailboxes cannot authenticate to Gmail SMTP.
# 2. Turn on 2-Step Verification for the account at https://myaccount.google.com/security
# 3. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
#    (If missing, your Workspace admin must enable App Passwords under Admin Console -> Security).
# 4. The From address must match SMTP_USER (Gmail will rewrite or reject mismatched senders).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=bookings@uncommon.org
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="OAK Clinics <bookings@uncommon.org>"
SMTP_SECURE=true

s


# --- OPTION 2: RESEND (Alternative) ---
